"""
The services of the API client: one module per service of the server schema. A service module is imported when its
name is first used, so importing this package loads none of them.
"""
{{ header }}
import importlib
from typing import Any

__all__ = [
{% for name in services %}
    "{{ name }}",
{% endfor %}
]


def __getattr__(name: str) -> Any:
    if name in __all__:
        return importlib.import_module(f"{__name__}.{name}")
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
