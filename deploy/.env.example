# Copied to deploy/.env by scripts/bootstrap.sh (git-ignored), which fills in the generated password.
# Placeholders only: never put a real secret in this tracked file.

# Sign-in (Keycloak). One admin login for Keycloak's master realm and the CairnML realm.
KC_ADMIN=cairnadmin
KC_ADMIN_PASSWORD=change-me
# The admin's password for the CairnML sign-in (the cairnml realm). Generated by bootstrap.sh when empty, and kept
# apart from KC_ADMIN_PASSWORD: the two systems do not share a password.
CAIRNML_ADMIN_PASSWORD=

# Optional: the ports this stack publishes on the machine. Set one when something else already uses it; the stack
# follows (the proxy, and the addresses the server gives to clients).
#   CAIRNML_HTTP_PORT            the one address clients use: the web app, the API and the sign-in service (default 80).
#                                The address then needs the port, e.g. http://<ip>:8081/cairnml/
#   CAIRNML_STORAGE_PORT         object storage, which clients reach through presigned URLs (default 9000)
#   CAIRNML_STORAGE_CONSOLE_PORT the storage console, on this machine only (default 9001)
# CAIRNML_HTTP_PORT=8081
# CAIRNML_STORAGE_PORT=9100
# CAIRNML_STORAGE_CONSOLE_PORT=9101
#
# Optional: the address the stack is reached at, with scheme and port, e.g. https://cairnml.example or
# http://192.168.1.20:8081. Set it for a deployment that has a fixed address: the server then names this address in
# everything security-relevant (sign-in, device enrolment, storage links) and ignores the Host the requests carry.
# Empty: each client's own address, which suits a LAN without configuration. Run bootstrap.sh again after changing it.
# CAIRNML_PUBLIC_ORIGIN=
#
# Optional: the proxies whose forwarded address headers (X-Forwarded-Host, X-Forwarded-Proto) the server believes, as a
# JSON list of addresses or networks. Headers from any other address are ignored. Default: loopback and the Docker
# network of the stack, where the proxy sits. Add the range of another reverse proxy in front of the stack.
# CAIRNML_TRUSTED_PROXIES='["127.0.0.0/8","::1/128","172.16.0.0/12"]'

# CAIRNML_IDP_ADMIN_PORT: the sign-in service's admin console is published on this machine's loopback address only, at
# http://127.0.0.1:8180/cairnml/idp/admin/ (from another machine, through an SSH tunnel to that port). Default 8180.
# CAIRNML_IDP_ADMIN_PORT=8180

# Optional: the ports of the API and of the sign-in service inside the stack's own network. They are not published, so
# nothing on this machine can clash with them and there is rarely a reason to change them; the proxy follows if you do.
# CAIRNML_API_PORT=8008
# CAIRNML_IDP_PORT=8180

# Object storage (RustFS). The root user is used once, by the storage init job; the server
# uses CAIRNML_S3_ACCESS_KEY with the secret in secrets/cairnml/s3_secret_key (written by bootstrap.sh).
RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=change-me
CAIRNML_S3_ACCESS_KEY=cairnml-server
# Optional: the address clients use to reach object storage. Empty: the address the client used to reach the
# server, on port 9000 (the presigned URLs name it).
CAIRNML_STORAGE_PUBLIC_URL=

# Where the stack keeps its data and secrets (data/, secrets/). Outside the repository, so a git clean or a re-clone
# cannot touch them. Default: ~/.local/share/cairnml. Uncomment to change it.
# CAIRNML_HOME=/srv/cairnml

# CairnML server. Optional: the GitHub App (see README, "GitHub App") and the cookie setting for https.
# GITHUB_APP_ID: the App's ID. Empty: jobs from GitHub repositories are refused, and dataset registration is refused too.
GITHUB_APP_ID=
# The GitHub API of the App. Change it only for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com
# Set to true only when the CairnML addresses are https: the session cookies are then sent only over https.
CAIRNML_COOKIE_SECURE=false

# Optional: the dataset registry (see README, "Datasets"). Both empty: dataset registration is off.
# CAIRNML_DATASET_REGISTRY: owner/name of the GitHub repository that lists the registered datasets, one file each.
# CAIRNML_DATASET_OWNERS: the GitHub owners whose dataset repositories may be registered there, as a JSON list.
# CAIRNML_DATASET_REGISTRY=acme/external-datasets
# CAIRNML_DATASET_OWNERS='["acme"]'
CAIRNML_DATASET_REGISTRY=
CAIRNML_DATASET_OWNERS=
# The repositories the server builds from are the commits in docker/build/, fetched by scripts/fetch-sources.sh. To build
# the web app from a checkout of your own instead, set its path here:
# CAIRNML_WEB_DIR=/path/to/cairnml-web
